# Exemplo de .env (NUNCA comitar este arquivo com valores reais)
# Copie este arquivo para .env e preencha os valores reais no seu ambiente local/servidor.

# App
NODE_ENV=production
PORT=3000

# Banco de dados
POSTGRES_DB=madasatec
POSTGRES_USER=madasatec
POSTGRES_PASSWORD=PUT_YOUR_DB_PASSWORD_HERE
DATABASE_URL=postgresql://madasatec:PUT_YOUR_DB_PASSWORD_HERE@madasatec-db:5432/madasatec

# Webhooks / integrações
N8N_WEBHOOK_URL=https://example.com/webhook/projeto-m

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=PUT_YOUR_SMTP_PASSWORD_HERE

# Sessões / segurança
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Dicas:
# - Gere SESSION_SECRET com: openssl rand -base64 32
# - Nunca coloque valores reais em .env.example
# - Adicione .env ao .gitignore (este repo já tem .env no .gitignore)
